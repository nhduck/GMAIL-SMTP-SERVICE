# Server Configuration
PORT=3000
NODE_ENV=development

# Operating Mode: SANDBOX (mặc định không cần cấu hình) hoặc LIVE_GMAIL
MODE=SANDBOX

# Gmail Bot Credentials (Chỉ cần khi bật MODE=LIVE_GMAIL)
# Lưu ý quan trọng khi Demo Live: Cần 2 tài khoản Gmail khác nhau:
# 1. GMAIL_USER: Tài khoản dịch vụ gửi mail tự động (Bot)
# 2. MANAGER_EMAIL: Tài khoản cá nhân của Quản lý nhận thư và bấm Reply
GMAIL_USER=your_bot_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=TMT Company

# Inbound Webhook & IMAP Configuration (Giao tiếp hai chiều SMTP & IMAP)
ENABLE_INBOUND=true
WEBHOOK_URL=http://localhost:4000/api/webhook/email-reply
WEBHOOK_SECRET=sec_seminar_webhook_key

# Security & Business Rule Configuration (Đồng bộ TTL 5 phút)
OTP_TTL_MINUTES=5
RESET_TTL_MINUTES=5
# API_KEY=your-secret-api-key-here

# Demo Leave App Configuration (Cổng 4000)
DEMO_PORT=4000
DEMO_APP_URL=http://localhost:4000
# Email của Quản lý nhận thư phê duyệt (phải khác GMAIL_USER khi chạy Live để tránh vòng lặp)
MANAGER_EMAIL=your_personal_manager@gmail.com
