# Server Configuration
PORT=3000
NODE_ENV=development

# Operating Mode: SANDBOX (default, zero-config) or LIVE_GMAIL
MODE=SANDBOX

# Gmail Credentials (Required only when MODE=LIVE_GMAIL)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Inbound Webhook & IMAP Configuration (Mở rộng tùy chọn - Mặc định tắt)
ENABLE_INBOUND=false
WEBHOOK_URL=http://localhost:4000/api/email-received
