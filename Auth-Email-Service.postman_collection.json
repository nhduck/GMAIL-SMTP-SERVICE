{
	"info": {
		"_postman_id": "a90f38b2-d812-4299-8cf9-7981e428c0b1",
		"name": "Auth-Email-Service (SOA Gateway)",
		"description": "Bộ sưu tập API hoàn chỉnh cho hệ thống Hybrid Email-as-a-Service Gateway (Gmail SMTP & IMAP Hub chuẩn SOA).\nDành cho cả 3 thành viên (Thành, Đức, Đạt) kiểm thử và tích hợp.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Health & System Status",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/health",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "health"]
						},
						"description": "Kiểm tra tình trạng sống của máy chủ Email Gateway."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Email Service (3 Chức Năng Cốt Lõi Đề Bài)",
			"item": [
				{
					"name": "1. Verify Email (Account Verification OTP)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"to\": \"student@tdtu.edu.vn\",\n  \"name\": \"Nguyễn Văn A\",\n  \"otp\": \"654321\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/verify-email",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "verify-email"]
						},
						"description": "Gửi email xác thực tài khoản kèm mã OTP (Ở chế độ Live cần truyền otp hoặc verifyUrl; ở Sandbox có thể bỏ trống để tự sinh)."
					},
					"response": []
				},
				{
					"name": "2. Password Reset (Đặt Lại Mật Khẩu)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"to\": \"student@tdtu.edu.vn\",\n  \"name\": \"Nguyễn Văn A\",\n  \"resetUrl\": \"https://myapp.com/reset-password?token=sec_abc123\",\n  \"expiresInMinutes\": 5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/password-reset",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "password-reset"]
						},
						"description": "Gửi email khôi phục mật khẩu có liên kết đặt lại và thời hạn hết hạn 5 phút (mặc định)."
					},
					"response": []
				},
				{
					"name": "3. Send Template HTML Email",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"to\": \"student@tdtu.edu.vn\",\n  \"template\": \"custom-html\",\n  \"variables\": {\n    \"title\": \"Chào Mừng Tân Sinh Viên TDTU\",\n    \"content\": \"<p>Chúc mừng bạn đã hoàn tất đăng ký hệ thống.</p>\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/send",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "send"]
						},
						"description": "Gửi email HTML định dạng sẵn theo template của Gateway."
					},
					"response": []
				},
				{
					"name": "Send Raw Email (Generic / Tùy Biến)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"to\": \"client@example.com\",\n  \"subject\": \"Mã xác thực OTP tài khoản\",\n  \"html\": \"<div style=\\\"font-family: sans-serif; padding: 20px; background: #f8fafc; border-radius: 8px;\\\"><h2>Chào bạn,</h2><p>Mã kích hoạt OTP của bạn là: <b>889922</b></p></div>\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/send",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "send"]
						},
						"description": "Gửi email bất đồng bộ qua Gateway. Phản hồi 202 Accepted ngay lập tức."
					},
					"response": []
				},
				{
					"name": "Send Email (Demo Chặn Lỗi Validation RFC 5322)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"to\": \"dia-chi-email-khong-hop-le\",\n  \"subject\": \"Test lỗi\",\n  \"text\": \"\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/send",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "send"]
						},
						"description": "Demo khả năng chặn email sai định dạng hoặc thiếu nội dung của Validator."
					},
					"response": []
				},
				{
					"name": "Get Sandbox Mails",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/mails",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "mails"]
						},
						"description": "Lấy danh sách các email ảo đã lưu trữ trong bộ nhớ RAM ở chế độ Sandbox."
					},
					"response": []
				},
				{
					"name": "Clear Sandbox Mails",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/mails",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "mails"]
						},
						"description": "Dọn dẹp làm trống hòm thư Sandbox."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Queue & Circuit Breaker (Quản trị & Giám sát)",
			"item": [
				{
					"name": "Get Queue & Circuit Breaker Stats",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/queue/stats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "queue", "stats"]
						},
						"description": "Truy vấn thống kê hiệu năng hàng đợi (Queue SLA metrics, độ trễ, số job active/retry) và trạng thái Circuit Breaker."
					},
					"response": []
				},
				{
					"name": "Get Dead-Letter Queue (DLQ)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/queue/dlq",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "queue", "dlq"]
						},
						"description": "Lấy danh sách các email bị lỗi sau 3 lần thử lại nằm trong Dead-Letter Queue."
					},
					"response": []
				},
				{
					"name": "Retry a DLQ Job",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/queue/dlq/:jobId/retry",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "queue", "dlq", ":jobId", "retry"],
							"variable": [
								{
									"key": "jobId",
									"value": "JOB_UUID_HERE",
									"description": "ID của job trong DLQ cần gửi lại thủ công"
								}
							]
						},
						"description": "Chuyển 1 job từ Dead-Letter Queue trở lại hàng đợi chính để thử gửi lại."
					},
					"response": []
				},
				{
					"name": "Clear Dead-Letter Queue",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/queue/dlq",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "queue", "dlq"]
						},
						"description": "Xóa toàn bộ các job hỏng trong Dead-Letter Queue."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Configuration & Dual-Mode",
			"item": [
				{
					"name": "Get System Config",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/config",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "config"]
						},
						"description": "Lấy chế độ hiện tại (SANDBOX / LIVE_GMAIL) và trạng thái kết nối Gmail."
					},
					"response": []
				},
				{
					"name": "Switch Operating Mode",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mode\": \"SANDBOX\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/config/mode",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "config", "mode"]
						},
						"description": "Chuyển đổi giữa chế độ SANDBOX và LIVE_GMAIL."
					},
					"response": []
				},
				{
					"name": "Update Gmail Credentials",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user\": \"your_email@gmail.com\",\n  \"appPassword\": \"xxxx xxxx xxxx xxxx\",\n  \"webhookUrl\": \"http://localhost:4000/api/email-received\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/config/credentials",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "config", "credentials"]
						},
						"description": "Cập nhật Email và App Password 16 ký tự của Google cho chế độ Live."
					},
					"response": []
				}
			]
		}
	]
}
